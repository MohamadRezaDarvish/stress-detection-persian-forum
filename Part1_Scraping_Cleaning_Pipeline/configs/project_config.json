    "user_post_count_repair": "data/raw/repairs/user_post_count_repair.csv",
    "min_words": 3,
    "drop_missing_author": false,
    "gender_imputation": "historical_cached_recovery",
    "output_csv": "data/processed/ninisite_cleaned_enriched.csv",
    "audit_json": "outputs/audits/cleaning_audit.json",
    "combined_all_file": "inputs/combined_all.csv",
    "prefer_combined_all": true,
    "drop_missing_thread_title": true,
    "run_missing_gender_recovery": false,
    "historical_reference_rows_after_text_filter": 362026,
    "historical_reference_final_rows": 362017,
    "gender_recovery_mode": "historical_male_profile_cache_replay",
    "gender_unresolved_policy": "assume_female_after_historical_male_recovery",
    "category_recovery_csv": "inputs/enrichment/category_recovery.csv",
    "category_recovery_mode": "cached_historical_replay",
    "historical_expected_category_updates": 99442,
    "require_complete_category_after_repair": true,
    "historical_male_profile_cache_pkl": "inputs/enrichment/historical_male_profile_cache.pkl",
    "historical_male_profile_urls_csv": "inputs/enrichment/historical_male_profile_urls.csv",
    "historical_expected_unique_male_profiles": 1437,
    "historical_expected_final_male_rows": 6535,
    "legacy_late_gender_key_map_csv": "inputs/enrichment/gender_recovery_key_to_profile_url.csv",
    "legacy_late_gender_results_csv": "inputs/enrichment/gender_recovery_results.csv"
  },
  "proxy": {
    "input_csv": "data/processed/ninisite_cleaned_enriched.csv",
    "output_csv": "data/processed/ninisite_cleaned_stress_proxy.csv",
    "lexicon_csv": "data/processed/data_driven_lexicons.csv",
    "high_quantile": 0.75,
    "low_mode": "nsmallest",
    "low_n": 162000,
    "ratio_threshold": 2.0,
    "min_count": 10,
    "sampling": {
      "strategy": "three_band",
      "high_quantile": 0.95,
      "low_min": -0.5,
      "low_max": 0.2,
      "n_low": 500,
      "n_mid": 600,
      "n_high": 900
    },
    "initial_proxy_weights": {
      "post_neg_count_temp": 4.0,
      "post_neg_emoji": 2.0,
      "post_excl_count": 0.5,
      "has_question": 1.2,
      "post_pos_count_temp": -0.2,
