{
  "project_name": "Member C Early Data Pipeline: Scraping, Cleaning, Proxy Construction, and Initial Label Sampling",
  "random_seed": 42,
  "run_live_scrape": false,
  "use_demo_if_input_missing": false,
  "scraping": {
    "sections_file": "inputs/forum_sections.csv",
    "base_domain": "https://www.ninisite.com",
    "user_agent": "Mozilla/5.0 (compatible; academic-research; gentle-rate-limited)",
    "request_timeout_seconds": 25,
    "forum_page_delay_seconds": 3.0,
    "thread_page_delay_seconds": 1.2,
    "between_thread_delay_seconds": 2.0,
    "profile_delay_seconds": 1.0,
    "max_retries": 5,
    "backoff_base_seconds": 8.0,
    "recovery_rounds_per_run": 2,
    "min_replies": 1,
    "max_forum_pages": 100,
    "block_markers": [
      "slow down",
      "too many requests",
      "rate limit",
      "captcha"
    ],
    "posts_checkpoint": "data/raw/posts/posts_checkpoint.csv",
    "threads_manifest": "data/raw/posts/threads_manifest.csv",
    "thread_status": "data/raw/posts/thread_status.csv",
    "profile_checkpoint": "data/raw/profiles/profile_checkpoint.csv",
    "retry_unresolved_profile_gender": true
  },
  "cleaning": {
    "raw_posts_glob": "data/raw/posts/*.csv",
