      "post_pos_count_temp": -0.3,
      "post_pos_count": -0.08,
      "post_pos_emoji": -0.5
    },
    "historical_reference": {
      "clean_rows": 362017,
      "high_reference_rows": 96038,
      "low_reference_rows": 162000,
      "negative_stems": 565,
      "positive_stems": 2081,
      "refined_proxy": {
