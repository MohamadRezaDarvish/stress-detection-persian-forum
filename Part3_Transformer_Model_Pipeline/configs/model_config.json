{
  "model_name": "HooshvareLab/bert-fa-zwnj-base",
  "model_type": "ParsBERT (BERT-based, ZWNJ-aware)",
  "architecture": "BertForSequenceClassification (num_labels=1, problem_type=regression)",
  "num_folds": 5,
  "max_length": 384,
  "batch_size": 16,
  "num_epochs_full_model": 6,
  "fold_epochs": 5,
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "optimizer": "AdamW",
  "scheduler": "linear warmup (10%) -> linear decay",
  "gradient_clip_norm": 1.0,
  "gradient_accumulation_steps": 1,
  "early_stopping_patience": 2,
  "early_stopping_metric": "val_mae",
  "loss_function": "weighted_asymmetric_mse",
  "loss_params": {
    "under_prediction_penalty": 1.75,
    "weight_column": "training_sample_weight"
  },
  "mc_dropout_trials": 8,
  "embedding_method": "cls_token_last_hidden_state",
  "random_seed": 42,
  "mixed_precision": "none",
  "device": "cuda (A10G) or cpu"
}
